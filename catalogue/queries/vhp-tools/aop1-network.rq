# AOP 1 is typed and has both a molecular initiating event and an adverse outcome.
# AOP-Suite (pyaop) reads exactly these links for every network build.
PREFIX aopo: <http://aopkb.org/aop_ontology#>
ASK {
  <https://identifiers.org/aop/1> a aopo:AdverseOutcomePathway ;
      aopo:has_molecular_initiating_event ?mie ;
      aopo:has_adverse_outcome ?ao .
}
